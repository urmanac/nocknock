# NockNock Ingestion Worker Configuration
# Copy to config.yaml and fill in your Alchemy key

database_url: "postgresql://postgres:postgres@localhost:5432/nocknock"

# Alchemy Base Mainnet API keys
alchemy_api_keys:
  - "YOUR_ALCHEMY_API_KEY"

# Tracked sovereign wallet (Base mainnet)
tracked_wallets:
  - "0xeE114cC97eC5adeB34bA5645e315B497D8487a45"

# AMM pool addresses (Aerodrome vAMM-USDC/NOCK 0.3%)
tracked_pools:
  - "0x85f1aa3a70fedd1c52705c15baed143e675cd626"

# Token contracts on Base
token_addresses:
  - "0x4200000000000000000000000000000000000006"  # WETH
  - "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"  # USDC
  - "0x9B5E262cF9bb04869ab40b19AF91D2dc85761722"  # NOCK

tracked_ranges: []

# Fee & LP contract references
fee_contracts:
  - "0x4CbB6188C6101CAcd4eb1126Cc14882Bd93dc3DB"

lp_tokens:
  - "0x85f1aa3a70fedd1c52705c15baed143e675cd626"

# Sync interval in seconds
sync_window_seconds: 300

# API server port
port: 8080

# Uniswap V4 Position ID
v4_position_id: 3126000

# ============================================================
# Operator Strategic Profile & Baseline Parameters
# ============================================================
# These parameters capture operator baselines, invariant targets, and LP scaling anchors.
operator_profile:
  # Hard floor invariant: Minimum sovereign NOCK holding required before capital deployment.
  treasury_floor_nock: 100000.0

  # Uniswap V4 Position NFT #3126000 scaling anchors:
  # Baseline liquidity value recorded at position creation / initial compounding (65,719,361,234,409)
  v4_baseline_liquidity: 65719361234409.0
  # Baseline token balances in V4 position corresponding to baseline liquidity
  v4_baseline_nock: 4004.31227
  v4_baseline_usdc: 23.63241
  # Baseline uncollected fee harvest anchors for dynamic V4 yield extrapolation
  v4_fee_baseline_usdc: 0.0245
  v4_fee_baseline_nock: 1.4820

  # Virtual 60/40 split rule: fraction of realized fee harvests (and measurable net
  # capital gains) earmarked to the virtual tax reserve buffer. The remainder is
  # liquid growth dry powder. Purely internal accounting — no on-chain address change.
  tax_reserve_ratio: 0.40

  # Target allocation weights in Portfolio Deviation Matrix (basis points, sum = 10000 bps / 100%)
  target_weights_bps:
    treasury: 8000        # 80.00% Sovereign Treasury floor
    aerodrome_lp: 1000    # 10.00% Aerodrome volatile LP tranche
    uniswap_v4_lp: 500    #  5.00% Uniswap V4 concentrated LP tranche
    cash: 500             #  5.00% Liquid USDC cash & tax escrow buffer

# Optional Model Context Protocol (MCP) Bearer Token for /v1/mcp endpoint
# mcp_bearer_token: "your-secret-bearer-token"

# ============================================================
# Market Price Backfill Engine (v0.3.0)
# ============================================================
# Heals gaps in market_price_history from free public OHLCV feeds and extends
# daily depth for the multi-day RSI. The whole section is optional — every
# field defaults so existing config files keep working unchanged.
# market_data:
#   backfill_enabled: true
#   geckoterminal_base_url: "https://api.geckoterminal.com/api/v2"
#   dexscreener_base_url: "https://api.dexscreener.com/latest"
#   pool_address: "0x85f1aa3a70fedd1c52705c15baed143e675cd626"
#   gap_threshold_minutes: 15
#   min_history_days: 14
#   hourly_lookback: 168
#   daily_lookback: 30

# ============================================================
# Directive-Transition Notifications (issue #28)
# ============================================================
# The worker fires a notification only when the tactical directive CHANGES
# between sync cycles (e.g. HOLD & ACCRETE -> BATCH HARVEST SHOT). Delivery
# failures are logged, never fatal. All channels optional; leave empty to disable.
# notifications:
#   telegram_bot_token: "123456:ABC..."
#   telegram_chat_id: "123456789"
#   pushover_token: "pushover-app-token"
#   pushover_user: "pushover-user-key"
#   webhook_url: "https://hooks.example/nocknock"
#   cockpit_url: "https://your-host:3000/lite"   # deep link appended to notifications