# NockNock Ingestion Worker Configuration
# Copy to config.yaml and fill in your values

database_url: "postgresql://postgres:postgres@localhost:5432/nocknock?sslmode=disable"

# Premium Alchemy API keys (rotate periodically)
alchemy_api_keys:
  - "YOUR_ALCHEMY_KEY_1"
  - "YOUR_ALCHEMY_KEY_2"

# Ethereum/Base addresses to track (checksummed)
tracked_wallets:
  - "0x742d35Cc6634C0532925a3b844Bc9e7595f8fEb5"  # Example: main treasury
  - "0x8ad599c3a0ff1de082011efddc58f1908eb6e6d8"  # Example: strategy wallet

# AMM pool addresses (Aerodrome, Uniswap V4, etc.)
tracked_pools:
  - "0x8ad599c3a0ff1de082011efddc58f1908eb6e6d8"  # Aerodrome NOCK/USDC
  - "0x794f7e42b5f5c5c5c5c5c5c5c5c5c5c5c5c5c5c5"  # Uniswap V4 NOCK/WETH

# Concentrated liquidity range IDs (from Uniswap V4 subgraph)
tracked_ranges:
  - "0x1234...5678-100-200"
  - "0xabcd...ef01-150-250"

# Contract addresses with unclaimed fees
fee_contracts:
  - "0x1111111111111111111111111111111111111111"
  - "0x2222222222222222222222222222222222222222"

# Freshness sync window (seconds) — frontend uses same value
sync_window_seconds: 300

# Ingestion schedule (cron expression) — every 5 minutes default
schedule: "*/5 * * * *"

# API server port
port: 8080

# Path to compiled WASM brain
wasm_path: "../../brain/target/wasm32-wasip1/release/nocknock_brain.wasm"