# NockNock Ingestion Worker Configuration
# Copy to config.yaml and fill in your Alchemy key

database_url: "postgresql://postgres:postgres@localhost:5432/nocknock"

# Alchemy Base Mainnet API keys
alchemy_api_keys:
  - "YOUR_ALCHEMY_API_KEY"

# Tracked sovereign wallet (Base mainnet)
tracked_wallets:
  - "0xeE114cC97eC5adeB34bA5645e315B497D8487a45"

# Token contracts on Base
token_addresses:
  - "0x4200000000000000000000000000000000000006"  # WETH
  - "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"  # USDC
  - "0x9B5E262cF9bb04869ab40b19AF91D2dc85761722"  # NOCK

# ============================================================
# Tracked LP positions (v2.0.0) — real Uniswap portfolio
# ============================================================
# Identifiers below are RPC-discovery-verified (2026-10-24; ONCHAIN_INTEGRATION.md §5).
# The portfolio is Uniswap-only: the Aerodrome tranche was liquidated 2026-10-23.
# After a repositioning, re-run the Phase-1 discovery runbook and update this list.
#
# LP rebuild suggestions (v0.5.0): while LP is under target the engine sizes a deposit
# for each eligible position. By default the LP target is split equally across positions
# whose pool is live and which are in range. Optional per-position controls:
#     rebuild_weight_bps: 7000          # this position's share of the LP target (0 = never)
#     rebuild_when_out_of_range: true   # exception to "do not fill out-of-range positions"
#     deposit_url: "https://..."        # override where the suggestion's button goes
#
# A withdrawn position (#144): withdrawing an NFT position in the wallet app burns its
# NFT. NockNock then finds that the NFT no longer exists, and the entry is
# reported as closed: listed apart from the live positions, counted in no total, and
# ingestion goes on. You are notified once, and can remove the entry whenever you like. A mistyped
# nft_id reads the same way ("withdrawn and burned, or a mistyped nft_id"). Only proof
# counts: if the node does not answer, answers anything else, or is more than two
# minutes behind the chain, the cycle fails as before rather than drop a position that
# may still hold money. An NFT that still exists with no liquidity in it is not closed;
# it stays a live position holding nothing.
# A uniswap-v4 or uniswap-v3 entry needs the nft_id of an NFT that exists.
# An entry with no nft_id reads as token id 0, which does not exist: it is reported as
# closed, and if it is your only entry the cycle fails. To watch a price without holding
# a position, use an `aerodrome` entry on a NOCK/USDC pool with is_price_source: true:
# it has no NFT and is never closed.
# If the closed entry is the price source: a uniswap-v4 entry's pool keeps supplying the
# NOCK/USD price until you flag another position; a uniswap-v3 or aerodrome-cl entry
# fails the cycle with a message asking you to flag another position as is_price_source.
# If every configured position is closed the cycle fails, as with none configured.
positions:
  # Retired 2026-11-14 (both NFTs still exist in the wallet, empty; re-add to track again):
  #   #3163431  Uniswap v4 USDC/NOCK 0.75%, pool 0x91a9ef0a…f99c, ticks 267825..271050.
  #             Its pool has had no in-range liquidity since the 2026-11 liquidation.
  #   #3163432  Uniswap v4 ETH/NOCK 2%, pool 0xd3161520…71a8, ticks 65200..71200.
  #             Out of range; the operator does not fill out-of-range positions.

  # Position D — USDC/NOCK, Uniswap v4, 3.00% fee — wide raft and the NOCK/USD price
  # source (pool has active third-party liquidity). (RPC-verified via the
  # mint's ModifyLiquidity event: poolId, ticks 262200/282300, liquidity 48295502692597)
  - id: "uniswap-v4-nock-usdc-wide"
    protocol: "uniswap-v4"
    network: "base"
    nft_id: 3163450
    pool_id: "0x064a5df2ecfcb7c05779b147aa38e4b0e91c966267fbdbc8cf16addd83636b13"
    currency0: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"   # USDC
    currency1: "0x9B5E262cF9bb04869ab40b19AF91D2dc85761722"   # NOCK
    tick_lower: 262200
    tick_upper: 282300
    is_price_source: true

  # Position C — WETH/NOCK, Uniswap v3, 1% fee (Base canonical NPM; pool resolved
  # via the v3 factory getPool(WETH, NOCK, 10000))
  - id: "uniswap-v3-weth-nock"
    protocol: "uniswap-v3"
    network: "base"
    nft_id: 6336662
    npm_address: "0x03a520b32C04BF3bEEf7BEb72E919cf822Ed34f1"
    pool_address: "0x71a4a6f6ea5c26ce486b7ed0d8723a897ef5ad9a"
    is_price_source: false

  # Aero "Basic Volatile" NOCK/USDC pool (app.aero.xyz) — full range, x*y=k (v0.5.0,
  # issue #88). The position is an LP-token share of the pool's reserves and can never
  # go out of range. The aero.xyz app stakes LP on deposit, so the balance is read
  # through gauge_address. This pool's claimFees() reverts: no LP-claimable fees are
  # reported. The AERO the staked LP earns is read from the same gauge (v0.6.0, #93)
  # and shown as unclaimed AERO; without gauge_address it is stated as not read.
  # (The legacy Aerodrome NOCK/USDC pool 0x85f1aa3a…d626 is still the deepest market,
  # but app.aero.xyz does not list it, so it is not tracked as a position.)
  - id: "aero-basic-nock-usdc"
    protocol: "aerodrome"
    network: "base"
    pool_address: "0x770fE8Fc9248c6382950A86E39a9391B41D59e0A"
    # Gauge for this pool (verified 2026-11-14: stakingToken() is the pool). The
    # aero.xyz app stakes LP on deposit, so the staked balance is what the wallet owns.
    gauge_address: "0xc82782ee66d82c4d19db0429652091a085083526"
    is_price_source: false

  # Aero concentrated-liquidity ("CL", Slipstream) position (v0.6.0, issue #91). EXAMPLE,
  # commented out: uncomment and use your own NFT id to track one. Unlike the basic pool
  # above this is a RANGED position: it can go out of range, and then holds one token.
  #   nft_id        the position NFT's token id (app.aero.xyz dashboard, or the deposit tx)
  #   npm_address   the Aero CL position manager that minted it
  #   pool_address  the CL pool; checked every cycle: its nft() must be npm_address, and its
  #                 tokens and tick spacing the NFT's (a Uniswap pool of the same pair is refused)
  # The Aero app stakes the NFT in the pool's gauge on deposit. NockNock reads the gauge
  # from the pool and counts the position only if the gauge lists the NFT among this
  # wallet's stakes (or the wallet holds the NFT itself); otherwise the cycle fails.
  # While staked, swap fees go to the gauge, not to you: fees show as "not LP-claimable",
  # and the AERO you earn instead is read from that gauge and shown as unclaimed AERO
  # (#93; not counted in the total until you claim it). Its WETH counts in the
  # ETH pillar and its NOCK toward your NOCK total and floor. It is never offered an LP
  # rebuild deposit: its WETH leg would have to come from gas, and no Aero CL position is
  # sized at all (the Aero app's deposit link starts a new position, not an add to this NFT).
  # Values below are the WETH/NOCK CL200 pool, verified on Base 2026-11-16
  # (ONCHAIN_INTEGRATION.md §8):
  # - id: "aero-cl200-weth-nock"
  #   protocol: "aerodrome-cl"
  #   network: "base"
  #   nft_id: 2914490
  #   npm_address: "0x4857db576ee0e45f10525ec59527bfd10beec60b"
  #   pool_address: "0x957256c98d61A714081DE2EE70ae3A96c9b40874"
  #   is_price_source: false

  # A deployed ladder rung (v0.9.0, issue #167). EXAMPLE, commented out: use your own NFT,
  # ticks and transaction. A ladder is a USDC/NOCK concentrated range (uniswap-v4,
  # uniswap-v3 or aerodrome-cl) that you deployed to buy NOCK on the way down or to trade
  # near spot; each rung is its own NFT and its own entry. NockNock measures it and never
  # steers it: it counts in every total, in the floor-crossing price and in the
  # protected cash reserve (its USDC is part of the stable balance), but it is not NOCK LP:
  # no LP target, no rebuild suggestion, no "Dual Growth Engine Active" label.
  #   role        unset (the default meaning since #151: classified by its pair) or
  #               "ladder". Nothing else is accepted: any other value fails every cycle
  #               with a configuration error, exactly like an unknown protocol.
  #   rung        optional, ladder only: "near" (trades both ways near spot, for fees) or
  #               "deep" (waits near the bottom to accumulate). No default: unset is
  #               reported as unset. Later maintenance (#169) treats the two differently.
  #   deposit_tx  optional, ladder only: the transaction that minted this NFT (0x + 64 hex).
  #               Its receipt is the baseline for "net NOCK bought since deposit". It is
  #               checked against this position (sent by the tracked wallet, one deposit into
  #               this NFT, no swap in the same transaction, amounts that fit the range).
  #               Without it there is no baseline and none is invented. One per ladder: a
  #               rung you add to or partly withdraw reads "liquidity_changed" (no bought
  #               figure) until it is re-deployed as a new NFT with its own deposit_tx.
  #               Verified buys made after cost_basis.opening.as_of enter the whole-stack
  #               average cost.
  # A ladder may not be the price source, may not set rebuild_weight_bps,
  # rebuild_when_out_of_range: true or deposit_url, and may not be an `aerodrome` (full
  # range) entry: each is refused with a configuration error. AERO and ETH ladders are #170.
  # Adding or changing deposit_tx changes config.yaml, which on chudmax means a redeploy
  # (deploy.sh stores config.yaml as the nocknock-config secret).
  # - id: "ladder-deep-1"
  #   protocol: "uniswap-v4"
  #   network: "base"
  #   nft_id: <your NFT id>
  #   pool_id: "0x064a5df2ecfcb7c05779b147aa38e4b0e91c966267fbdbc8cf16addd83636b13"
  #   currency0: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"   # USDC
  #   currency1: "0x9B5E262cF9bb04869ab40b19AF91D2dc85761722"   # NOCK
  #   tick_lower: <from the mint>
  #   tick_upper: <from the mint>
  #   role: "ladder"
  #   rung: "deep"
  #   deposit_tx: "0x<the mint transaction hash>"

# Canonical Uniswap v3 WETH/USDC 0.05% pool (Base) for the live ETH/USD spot (slot0).
# Resolved via the verified v3 factory getPool and price-checked at discovery.
eth_price_pool: "0xd0b53d9277642d899df5c87a3966a349a798f224"

# AERO/USD price source (v0.6.0, issue #93): an AERO/USDC pool whose slot0 prices AERO,
# the fourth pillar. Default: the Aero CL200 AERO/USDC pool, the deepest found on Base on
# 2026-11-16 (ONCHAIN_INTEGRATION.md §9). Checked every cycle: its tokens must be AERO
# (0x3f5bF3EdAc59d650D8fDf9657a71F2f904A3a4Ee, the token the Aero gauges pay; not the
# older "Aerodrome" token 0x940181a9…8631) and USDC, and it must have in-range liquidity,
# or no price is used. While the wallet holds AERO this read is required (a failed read
# fails the cycle); while it holds none, a failed read only leaves AERO unpriced.
# NockNock reads AERO and states amounts. It sets no target and gives no advice about it.
aero_price_pool: "0xd0acf293547457fb4fe9ee32ca93e89497626816"

# Sync interval in seconds
sync_window_seconds: 300

# API server port
port: 8080

# ============================================================
# Operator Strategic Profile
# ============================================================
operator_profile:
  # Hard floor invariant: Minimum sovereign NOCK holding required before capital deployment.
  treasury_floor_nock: 100000.0

  # LP floor tolerance: how far below the floor the stack may fall if every LP range
  # sold ALL its NOCK, in basis points of the floor (500 = 5% = 5,000 NOCK of 100,000).
  # Ranges sell gradually as price rises, so a small overage lets more NOCK trade and
  # earn fees. 0 (default) keeps every floor NOCK out of LP.
  lp_floor_tolerance_bps: 0

  # Virtual 60/40 split rule: fraction of realized fee harvests (and measurable net
  # capital gains) earmarked to the virtual tax reserve buffer. The remainder is
  # liquid growth dry powder. Purely internal accounting — no on-chain address change.
  tax_reserve_ratio: 0.40

  # Optional standing protected cash reserve in USDC (#162): dry powder you keep for
  # buying lower after a drawdown. It does not end with an accumulation plan. It is
  # measured on wallet USDC plus USDC inside NOCK LP (moving USDC into a NOCK range does
  # not use it up; buying NOCK does; a gas-side ETH/USDC range does not count). No dry
  # powder is reported above it and no plan buy draws below it. Unset = no rule.
  # cash_reserve_usdc: 950

  # Optional ladder bottom in USD per NOCK (v0.9.0, #168): the lowest price a NOCK ladder
  # buys down to. YOUR number, no default: unset, the ladder card says this setting is
  # needed and lists candidate bottoms as a measurement, none picked. Write a plain
  # number (0.01, not $0.01). Like every numeric key, a value that is not a number (text,
  # "$0.01", "0,01", .nan, .inf) stops the worker at startup with a config error; a
  # number at or below 0 is reported on the card as invalid and nothing is sized (the
  # cycle does not fail). With it and cash_reserve_usdc set, the dashboard's ladder card
  # states the range from the usable tick at or below spot down to this bottom, holding
  # the most USDC that leaves the stable balance at cash_reserve_usdc at this price,
  # and a Uniswap link that prefills the pool and the range, with the amount printed.
  # NockNock signs and sends nothing.
  # ladder_bottom_usd: 0.01

  # Target allocation weights in Portfolio Deviation Matrix (basis points, sum = 10000).
  # v2.0.0: Aerodrome tranche liquidated — the LP bucket is the aggregate across the
  # tracked positions. Since #151 the LP target counts NOCK-pair positions only (token0
  # or token1 is NOCK): a tracked range with no NOCK leg, such as a gas-side WETH/USDC
  # range, is measured (its own no-target row) and never steered by this weight.
  # Legacy `aerodrome_lp`/`uniswap_v4_lp` keys still parse but are ignored.
  target_weights_bps:
    treasury: 8000        # 80.00% Sovereign Treasury floor
    uniswap_lp: 1500      # 15.00% NOCK LP (NOCK-pair positions only)
    cash: 500             #  5.00% Liquid USDC cash & tax escrow buffer

# Optional Model Context Protocol (MCP) Bearer Token for /v1/mcp endpoint
# mcp_bearer_token: "your-secret-bearer-token"

# ============================================================
# Accumulation Plan — dollar-cost-averaged NOCK buys (v0.5.0)
# ============================================================
# Optional. While this section exists the advice engine paces buys in tranches
# ("DCA TRANCHE DUE (3 of 10)") instead of advising one lump-sum deployment. The plan
# only PACES: you make each swap yourself (e.g. on Aero, aero.xyz). NockNock then finds
# the swap on-chain and offers it on the dashboard for you to confirm (v0.6.0), or you
# record its transaction hash (dashboard, or POST /v1/execute/record-accumulation).
# Progress is counted from receipt-verified buys you confirmed; missed windows never stack.
# Budget, tranche count and cadence are your allocation decision — there is no default.
# accumulation_plan:
#   id: "2026-11-reentry"          # label; keys the accumulation ledger
#   budget_usdc: 500               # total to deploy across the plan
#   tranches: 5                    # equal buys
#   interval_hours: 24             # minimum spacing between buys
#   starts_at: "2026-11-15T00:00:00Z"   # optional; default is immediately
#   venue: "Aero"                  # optional, no default: your own label for where you buy,
#                                  # shown as "your plan's venue label: Aero". Unset, the
#                                  # advice names no venue (NockNock never picks one; the
#                                  # route quotes compare Aero and Uniswap as facts).
#   max_price_usd: 0.020           # optional ceiling: pause while spot is above it
#   pause_when_overextended: true  # pause while daily RSI(14) >= 70
#   respect_cash_target: true      # never spend liquid USDC below target_weights_bps.cash
#   cash_reserve_usdc: 950         # this plan's protected reserve: never advise a buy that
#                                  # takes the stable balance below it. It ends with the
#                                  # plan; for a standing one use operator_profile's (#162).
#                                  # The plan honours the larger of the two.

# ============================================================
# Fill detection for the accumulation plan (v0.6.0, issue #118)
# ============================================================
# On by default while an accumulation_plan is configured: nothing to set. Each cycle the
# worker reads the tracked wallet's incoming NOCK transfers back to the plan anchor
# (starts_at, else the moment the plan id was first seen; one alchemy_getAssetTransfers
# call) and offers each swap that passes the recording rules. It never records a buy and
# has no thresholds. Set enabled: false to stop the check; recording a buy by its
# transaction hash keeps working either way.
# fill_detection:
#   enabled: true

# ============================================================
# Route quotes for a due tranche (v0.7.0, issue #115)
# ============================================================
# On by default while an accumulation_plan is configured: nothing to set. When the plan
# says a tranche is due, the worker asks Aero's and Uniswap's own quoter contracts what
# that exact tranche amount returns in NOCK (read-only eth_call, about a dozen RPC reads
# per cycle while a tranche is due), shows both venues and states which returns more
# NOCK. It quotes only the amount your plan produced, never another size, and it never
# signs or sends anything: you swap in the venue's own app. The routes are a built-in
# table verified on-chain (ONCHAIN_INTEGRATION.md section 11); there is nothing else to
# configure. Set enabled: false to stop the quoter calls; the due tranche is advised
# exactly as before.
# route_quotes:
#   enabled: true

# ============================================================
# Cost Basis — optional opening basis for the whole stack (v0.6.0)
# ============================================================
# NockNock always reports the average cost of the buys its accumulation plan verified,
# and charts it against the price. That needs nothing here.
#
# It cannot work out what the REST of your NOCK cost: the chain does not say what you
# paid before, what you sold, or what moved through LP. If you want a whole-stack
# average, enter your own opening figures below, read from wherever you keep them (a
# wallet app's performance panel, a tax tool, a spreadsheet). NockNock never fills these
# in. Leave the block commented out and the whole-stack basis reads "not configured".
#
# All four keys are required together. A half-filled block, a zero or negative amount, a
# date without a time, or an as_of in the future is reported as a configuration error
# (dashboard, snapshot, MCP); it is never completed with a default.
#
#   Blended average = (cost_usd + USDC of verified buys confirmed after as_of)
#                   / (nock_amount + NOCK received in those buys)
#
# Buys confirmed at or before as_of are taken to be inside your figures already.
# Not tracked after as_of: sells, LP ranges selling or buying NOCK, fees earned,
# transfers in or out, and buys you did not record.
# cost_basis:
#   opening:
#     nock_amount: <NOCK you held at as_of, as a number>
#     cost_usd: <what that NOCK cost you in total, in USD, as a number>
#     as_of: <the instant you read those figures, written like "YYYY-MM-DDTHH:MM:SSZ">
#     source: <where the figures came from, in your own words>

# ============================================================
# Market Price Backfill Engine (v0.3.0)
# ============================================================
# Heals gaps in market_price_history from free public OHLCV feeds and extends
# daily depth for the multi-day RSI. The whole section is optional — every
# field defaults so existing config files keep working unchanged.
# pool_address is the pool whose OHLCV history feeds RSI; it should be the deepest
# NOCK/USDC market. The code default is the v4 0.75% pool, which went illiquid after
# the 2026-11 liquidation, so it is pinned here to the legacy Aerodrome vAMM, still the
# highest-volume NOCK/USDC market on 2026-11-14 although aero.xyz no longer routes
# through it (ONCHAIN_INTEGRATION.md §6). Re-point this if that pool goes quiet.
# Providers without coverage degrade fail-open (warnings only).
market_data:
  pool_address: "0x85f1aa3a70fedd1c52705c15baed143e675cd626"
#   backfill_enabled: true
#   geckoterminal_base_url: "https://api.geckoterminal.com/api/v2"
#   dexscreener_base_url: "https://api.dexscreener.com/latest"
#   gap_threshold_minutes: 15
#   min_history_days: 14
#   hourly_lookback: 168
#   daily_lookback: 30

# ============================================================
# Notifications (issues #28, #89): optional, off until you set a channel
# ============================================================
# The worker pushes a message when the directive CHANGES between two sync cycles (for
# example DCA ON SCHEDULE -> DCA TRANCHE DUE, or HOLD & ACCRETE -> DEFENSIVE LOCK), when
# an accumulation plan completes, and when spot reaches the top of the price-source range
# (a range exit). Never on a repeat. Delivery failures are logged, never fatal. Every
# channel is optional; with none set nothing is sent.
#
# Check a channel without waiting for a change ("SEND TEST NOTIFICATION" on the
# dashboard does the same):
#   curl -X POST http://<host>:8081/v1/notifications/test
#
# Telegram: in the Telegram app, message BotFather, send /newbot and copy the token it
#   gives you (telegram_bot_token). Open a chat with your new bot and send it any
#   message, then open https://api.telegram.org/bot<token>/getUpdates in a browser:
#   result[0].message.chat.id is telegram_chat_id.
# Pushover: at pushover.net, "Your User Key" is pushover_user; "Create an
#   Application/API Token" gives pushover_token. (pushover_user_key, this file's name
#   for the user key until v0.5.3, is read when pushover_user is not set.)
# Full steps: DEPLOYMENT.md section 7.
#
# Keep this block commented here. This file is the base layer of the worker's config, so
# a value left uncommented in it is live for every deployment that does not override it.
# notifications:
#   telegram_bot_token: "123456789:AA..."
#   telegram_chat_id: "123456789"
#   pushover_token: "your-application-api-token"
#   pushover_user: "your-user-key"
#   webhook_url: "https://hooks.example/nocknock"     # receives POST {"text": "..."}
#   cockpit_url: "http://your-host:3000/?view=lite"   # link appended to each message
