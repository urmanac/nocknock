# NockNock Ingestion Worker Configuration
# Copy to config.yaml and fill in your Alchemy key

database_url: "postgresql://postgres:postgres@localhost:5432/nocknock"

# Alchemy Base Mainnet API keys
alchemy_api_keys:
  - "YOUR_ALCHEMY_API_KEY"

# Tracked sovereign wallet (Base mainnet)
tracked_wallets:
  - "0xeE114cC97eC5adeB34bA5645e315B497D8487a45"

# Token contracts on Base
token_addresses:
  - "0x4200000000000000000000000000000000000006"  # WETH
  - "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"  # USDC
  - "0x9B5E262cF9bb04869ab40b19AF91D2dc85761722"  # NOCK

# ============================================================
# Tracked LP positions (v2.0.0) — real Uniswap portfolio
# ============================================================
# Identifiers below are RPC-discovery-verified (2026-10-24; ONCHAIN_INTEGRATION.md §5).
# The portfolio is Uniswap-only: the Aerodrome tranche was liquidated 2026-10-23.
# After a repositioning, re-run the Phase-1 discovery runbook and update this list.
positions:
  # Position B — NOCK/USDC, Uniswap v4, 0.75% fee (the NOCK/USD price source)
  - id: "uniswap-v4-nock-usdc"
    protocol: "uniswap-v4"
    network: "base"
    nft_id: 3163431
    pool_id: "0x91a9ef0a8dd231b99fa53a2a145a9e8bca7897e0d85852107abb997916f9f99c"
    currency0: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"   # USDC
    currency1: "0x9B5E262cF9bb04869ab40b19AF91D2dc85761722"   # NOCK
    tick_lower: 267825
    tick_upper: 271050
    is_price_source: true

  # Position A — ETH/NOCK, Uniswap v4, 2% fee (currency0 = native ETH)
  - id: "uniswap-v4-nock-eth"
    protocol: "uniswap-v4"
    network: "base"
    nft_id: 3163432
    pool_id: "0xd316152008e12105594c32686b9d0401fd2c60ca4805c84f280069d218b771a8"
    currency0: "0x0000000000000000000000000000000000000000"   # native ETH
    currency1: "0x9B5E262cF9bb04869ab40b19AF91D2dc85761722"   # NOCK
    tick_lower: 65200
    tick_upper: 71200
    is_price_source: false

  # Position D — USDC/NOCK, Uniswap v4, 3.00% fee — wide raft (RPC-verified via the
  # mint's ModifyLiquidity event: poolId, ticks 262200/282300, liquidity 48295502692597)
  - id: "uniswap-v4-nock-usdc-wide"
    protocol: "uniswap-v4"
    network: "base"
    nft_id: 3163450
    pool_id: "0x064a5df2ecfcb7c05779b147aa38e4b0e91c966267fbdbc8cf16addd83636b13"
    currency0: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"   # USDC
    currency1: "0x9B5E262cF9bb04869ab40b19AF91D2dc85761722"   # NOCK
    tick_lower: 262200
    tick_upper: 282300
    is_price_source: false

  # Position C — WETH/NOCK, Uniswap v3, 1% fee (Base canonical NPM; pool resolved
  # via the v3 factory getPool(WETH, NOCK, 10000))
  - id: "uniswap-v3-weth-nock"
    protocol: "uniswap-v3"
    network: "base"
    nft_id: 6336662
    npm_address: "0x03a520b32C04BF3bEEf7BEb72E919cf822Ed34f1"
    pool_address: "0x71a4a6f6ea5c26ce486b7ed0d8723a897ef5ad9a"
    is_price_source: false

# Canonical Uniswap v3 WETH/USDC 0.05% pool (Base) for the live ETH/USD spot (slot0).
# Resolved via the verified v3 factory getPool and price-checked at discovery.
eth_price_pool: "0xd0b53d9277642d899df5c87a3966a349a798f224"

# Sync interval in seconds
sync_window_seconds: 300

# API server port
port: 8080

# ============================================================
# Operator Strategic Profile
# ============================================================
operator_profile:
  # Hard floor invariant: Minimum sovereign NOCK holding required before capital deployment.
  treasury_floor_nock: 100000.0

  # Virtual 60/40 split rule: fraction of realized fee harvests (and measurable net
  # capital gains) earmarked to the virtual tax reserve buffer. The remainder is
  # liquid growth dry powder. Purely internal accounting — no on-chain address change.
  tax_reserve_ratio: 0.40

  # Target allocation weights in Portfolio Deviation Matrix (basis points, sum = 10000).
  # v2.0.0: Aerodrome tranche liquidated — the LP bucket is the aggregate across all
  # tracked Uniswap positions. Legacy `aerodrome_lp`/`uniswap_v4_lp` keys still parse
  # but are ignored.
  target_weights_bps:
    treasury: 8000        # 80.00% Sovereign Treasury floor
    uniswap_lp: 1500      # 15.00% Uniswap LP (all tracked positions)
    cash: 500             #  5.00% Liquid USDC cash & tax escrow buffer

# Optional Model Context Protocol (MCP) Bearer Token for /v1/mcp endpoint
# mcp_bearer_token: "your-secret-bearer-token"

# ============================================================
# Market Price Backfill Engine (v0.3.0)
# ============================================================
# Heals gaps in market_price_history from free public OHLCV feeds and extends
# daily depth for the multi-day RSI. The whole section is optional — every
# field defaults so existing config files keep working unchanged.
# pool_address defaults to the tracked v4 NOCK/USDC pool (0.75%); providers
# without coverage for it degrade fail-open (warnings only).
# market_data:
#   backfill_enabled: true
#   geckoterminal_base_url: "https://api.geckoterminal.com/api/v2"
#   dexscreener_base_url: "https://api.dexscreener.com/latest"
#   pool_address: "0x91a9ef0a8dd231b99fa53a2a145a9e8bca7897e0d85852107abb997916f9f99c"
#   gap_threshold_minutes: 15
#   min_history_days: 14
#   hourly_lookback: 168
#   daily_lookback: 30

# ============================================================
# Directive-Transition Notifications (issue #28)
# ============================================================
# The worker fires a notification only when the tactical directive CHANGES
# between sync cycles (e.g. HOLD & ACCRETE -> BATCH HARVEST SHOT). Delivery
# failures are logged, never fatal. All channels optional; leave empty to disable.
# notifications:
#   telegram_bot_token: "123456:ABC..."
#   telegram_chat_id: "123456789"
#   pushover_token: "pushover-app-token"
#   pushover_user_key: "pushover-user-key"
#   webhook_url: "https://hooks.example/nocknock"
#   cockpit_url: "https://your-host:3000/lite"   # deep link appended to notifications
