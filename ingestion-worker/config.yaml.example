# NockNock Ingestion Worker Configuration
# Copy to config.yaml and fill in your Alchemy key

database_url: "postgresql://postgres:postgres@localhost:5432/nocknock"

# Alchemy Base Mainnet API keys
alchemy_api_keys:
  - "YOUR_ALCHEMY_API_KEY"

# Tracked sovereign wallet (Base mainnet)
tracked_wallets:
  - "0xeE114cC97eC5adeB34bA5645e315B497D8487a45"

# Token contracts on Base
token_addresses:
  - "0x4200000000000000000000000000000000000006"  # WETH
  - "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"  # USDC
  - "0x9B5E262cF9bb04869ab40b19AF91D2dc85761722"  # NOCK

# ============================================================
# Tracked LP positions (v2.0.0) — real Uniswap portfolio
# ============================================================
# Identifiers below are RPC-discovery-verified (2026-10-24; ONCHAIN_INTEGRATION.md §5).
# The portfolio is Uniswap-only: the Aerodrome tranche was liquidated 2026-10-23.
# After a repositioning, re-run the Phase-1 discovery runbook and update this list.
#
# LP rebuild suggestions (v0.5.0): while LP is under target the engine sizes a deposit
# for each eligible position. By default the LP target is split equally across positions
# whose pool is live and which are in range. Optional per-position controls:
#     rebuild_weight_bps: 7000          # this position's share of the LP target (0 = never)
#     rebuild_when_out_of_range: true   # exception to "do not fill out-of-range positions"
#     deposit_url: "https://..."        # override where the suggestion's button goes
positions:
  # Retired 2026-11-14 (both NFTs still exist in the wallet, empty; re-add to track again):
  #   #3163431  Uniswap v4 USDC/NOCK 0.75%, pool 0x91a9ef0a…f99c, ticks 267825..271050.
  #             Its pool has had no in-range liquidity since the 2026-11 liquidation.
  #   #3163432  Uniswap v4 ETH/NOCK 2%, pool 0xd3161520…71a8, ticks 65200..71200.
  #             Out of range; the operator does not fill out-of-range positions.

  # Position D — USDC/NOCK, Uniswap v4, 3.00% fee — wide raft and the NOCK/USD price
  # source (pool has active third-party liquidity). (RPC-verified via the
  # mint's ModifyLiquidity event: poolId, ticks 262200/282300, liquidity 48295502692597)
  - id: "uniswap-v4-nock-usdc-wide"
    protocol: "uniswap-v4"
    network: "base"
    nft_id: 3163450
    pool_id: "0x064a5df2ecfcb7c05779b147aa38e4b0e91c966267fbdbc8cf16addd83636b13"
    currency0: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"   # USDC
    currency1: "0x9B5E262cF9bb04869ab40b19AF91D2dc85761722"   # NOCK
    tick_lower: 262200
    tick_upper: 282300
    is_price_source: true

  # Position C — WETH/NOCK, Uniswap v3, 1% fee (Base canonical NPM; pool resolved
  # via the v3 factory getPool(WETH, NOCK, 10000))
  - id: "uniswap-v3-weth-nock"
    protocol: "uniswap-v3"
    network: "base"
    nft_id: 6336662
    npm_address: "0x03a520b32C04BF3bEEf7BEb72E919cf822Ed34f1"
    pool_address: "0x71a4a6f6ea5c26ce486b7ed0d8723a897ef5ad9a"
    is_price_source: false

  # Aero "Basic Volatile" NOCK/USDC pool (app.aero.xyz) — full range, x*y=k (v0.5.0,
  # issue #88). The position is an LP-token share of the pool's reserves and can never
  # go out of range. The aero.xyz app stakes LP on deposit, so the balance is read
  # through gauge_address. This pool's claimFees() reverts: no LP-claimable fees are
  # reported, and rewards earned by staked LP are not read.
  # (The legacy Aerodrome NOCK/USDC pool 0x85f1aa3a…d626 is still the deepest market,
  # but app.aero.xyz does not list it, so it is not tracked as a position.)
  - id: "aero-basic-nock-usdc"
    protocol: "aerodrome"
    network: "base"
    pool_address: "0x770fE8Fc9248c6382950A86E39a9391B41D59e0A"
    # Gauge for this pool (verified 2026-11-14: stakingToken() is the pool). The
    # aero.xyz app stakes LP on deposit, so the staked balance is what the wallet owns.
    gauge_address: "0xc82782ee66d82c4d19db0429652091a085083526"
    is_price_source: false

# Canonical Uniswap v3 WETH/USDC 0.05% pool (Base) for the live ETH/USD spot (slot0).
# Resolved via the verified v3 factory getPool and price-checked at discovery.
eth_price_pool: "0xd0b53d9277642d899df5c87a3966a349a798f224"

# Sync interval in seconds
sync_window_seconds: 300

# API server port
port: 8080

# ============================================================
# Operator Strategic Profile
# ============================================================
operator_profile:
  # Hard floor invariant: Minimum sovereign NOCK holding required before capital deployment.
  treasury_floor_nock: 100000.0

  # LP floor tolerance: how far below the floor the stack may fall if every LP range
  # sold ALL its NOCK, in basis points of the floor (500 = 5% = 5,000 NOCK of 100,000).
  # Ranges sell gradually as price rises, so a small overage lets more NOCK trade and
  # earn fees. 0 (default) keeps every floor NOCK out of LP.
  lp_floor_tolerance_bps: 0

  # Virtual 60/40 split rule: fraction of realized fee harvests (and measurable net
  # capital gains) earmarked to the virtual tax reserve buffer. The remainder is
  # liquid growth dry powder. Purely internal accounting — no on-chain address change.
  tax_reserve_ratio: 0.40

  # Target allocation weights in Portfolio Deviation Matrix (basis points, sum = 10000).
  # v2.0.0: Aerodrome tranche liquidated — the LP bucket is the aggregate across all
  # tracked Uniswap positions. Legacy `aerodrome_lp`/`uniswap_v4_lp` keys still parse
  # but are ignored.
  target_weights_bps:
    treasury: 8000        # 80.00% Sovereign Treasury floor
    uniswap_lp: 1500      # 15.00% Uniswap LP (all tracked positions)
    cash: 500             #  5.00% Liquid USDC cash & tax escrow buffer

# Optional Model Context Protocol (MCP) Bearer Token for /v1/mcp endpoint
# mcp_bearer_token: "your-secret-bearer-token"

# ============================================================
# Accumulation Plan — dollar-cost-averaged NOCK buys (v0.5.0)
# ============================================================
# Optional. While this section exists the advice engine paces buys in tranches
# ("DCA TRANCHE DUE (3 of 10)") instead of advising one lump-sum deployment. The plan
# only PACES: you make each swap yourself (e.g. on Aero, aero.xyz). NockNock then finds
# the swap on-chain and offers it on the dashboard for you to confirm (v0.6.0), or you
# record its transaction hash (dashboard, or POST /v1/execute/record-accumulation).
# Progress is counted from receipt-verified buys you confirmed; missed windows never stack.
# Budget, tranche count and cadence are your allocation decision — there is no default.
# accumulation_plan:
#   id: "2026-11-reentry"          # label; keys the accumulation ledger
#   budget_usdc: 500               # total to deploy across the plan
#   tranches: 5                    # equal buys
#   interval_hours: 24             # minimum spacing between buys
#   starts_at: "2026-11-15T00:00:00Z"   # optional; default is immediately
#   venue: "Aero"                  # label shown in advice (aero.xyz, formerly Aerodrome)
#   max_price_usd: 0.020           # optional ceiling: pause while spot is above it
#   pause_when_overextended: true  # pause while daily RSI(14) >= 70
#   respect_cash_target: true      # never spend liquid USDC below target_weights_bps.cash
#   cash_reserve_usdc: 950         # protected reserve: never advise a buy that takes liquid
#                                  # USDC below this, at any price (keep dry powder for a dip)

# ============================================================
# Fill detection for the accumulation plan (v0.6.0, issue #118)
# ============================================================
# On by default while an accumulation_plan is configured: nothing to set. Each cycle the
# worker reads the tracked wallet's incoming NOCK transfers back to the plan anchor
# (starts_at, else the moment the plan id was first seen; one alchemy_getAssetTransfers
# call) and offers each swap that passes the recording rules. It never records a buy and
# has no thresholds. Set enabled: false to stop the check; recording a buy by its
# transaction hash keeps working either way.
# fill_detection:
#   enabled: true

# ============================================================
# Route quotes for a due tranche (v0.7.0, issue #115)
# ============================================================
# On by default while an accumulation_plan is configured: nothing to set. When the plan
# says a tranche is due, the worker asks Aero's and Uniswap's own quoter contracts what
# that exact tranche amount returns in NOCK (read-only eth_call, about a dozen RPC reads
# per cycle while a tranche is due), shows both venues and states which returns more
# NOCK. It quotes only the amount your plan produced, never another size, and it never
# signs or sends anything: you swap in the venue's own app. The routes are a built-in
# table verified on-chain (ONCHAIN_INTEGRATION.md section 9); there is nothing else to
# configure. Set enabled: false to stop the quoter calls; the due tranche is advised
# exactly as before.
# route_quotes:
#   enabled: true

# ============================================================
# Market Price Backfill Engine (v0.3.0)
# ============================================================
# Heals gaps in market_price_history from free public OHLCV feeds and extends
# daily depth for the multi-day RSI. The whole section is optional — every
# field defaults so existing config files keep working unchanged.
# pool_address is the pool whose OHLCV history feeds RSI; it should be the deepest
# NOCK/USDC market. The code default is the v4 0.75% pool, which went illiquid after
# the 2026-11 liquidation, so it is pinned here to the legacy Aerodrome vAMM, still the
# highest-volume NOCK/USDC market on 2026-11-14 although aero.xyz no longer routes
# through it (ONCHAIN_INTEGRATION.md §6). Re-point this if that pool goes quiet.
# Providers without coverage degrade fail-open (warnings only).
market_data:
  pool_address: "0x85f1aa3a70fedd1c52705c15baed143e675cd626"
#   backfill_enabled: true
#   geckoterminal_base_url: "https://api.geckoterminal.com/api/v2"
#   dexscreener_base_url: "https://api.dexscreener.com/latest"
#   gap_threshold_minutes: 15
#   min_history_days: 14
#   hourly_lookback: 168
#   daily_lookback: 30

# ============================================================
# Directive-Transition Notifications (issue #28)
# ============================================================
# The worker fires a notification only when the tactical directive CHANGES
# between sync cycles (e.g. HOLD & ACCRETE -> BATCH HARVEST SHOT). Delivery
# failures are logged, never fatal. All channels optional; leave empty to disable.
# notifications:
#   telegram_bot_token: "123456:ABC..."
#   telegram_chat_id: "123456789"
#   pushover_token: "pushover-app-token"
#   pushover_user_key: "pushover-user-key"
#   webhook_url: "https://hooks.example/nocknock"
#   cockpit_url: "https://your-host:3000/lite"   # deep link appended to notifications
